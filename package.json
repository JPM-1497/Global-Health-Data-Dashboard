{
  "name": "global-intelligence-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build:web": "npm run build --workspace=apps/web",
    "build:worker": "npm run build --workspace=apps/worker",
    "build": "npm run build:web && npm run build:worker",
    "sample:world-bank": "node scripts/fetch-world-bank-sample.mjs",
